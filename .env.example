# DAN environment (never commit real secrets)

# Required for Supabase mode (Cloudflare Pages / local .env.local)
# Vite only exposes VITE_* — NEXT_PUBLIC_* names will NOT work here.
VITE_SUPABASE_URL=
# anon key OR new publishable key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=

# Optional: force demo localStorage adapter even if Supabase env is set
# VITE_DATA_MODE=demo
# Alias (legacy): VITE_DAN_DATA_MODE=demo
