# DAN environment
# Copy to .env.local for local work. Never commit .env or .env.local.
# Vite exposes only VITE_* to the browser. Anything secret must not use that prefix.

# --- Browser public values (required for supabase mode) ---
# Public project URL. Safe to ship in the frontend bundle.
# Local/staging: use the STAGING Supabase project URL, never production.
VITE_SUPABASE_URL=
# Supabase anon key, or the newer publishable key (sb_publishable_...).
# Public client key. Never put service_role / sb_secret here.
VITE_SUPABASE_ANON_KEY=

# --- Mode switch (optional, public) ---
# Unset: use supabase when both values above are present, otherwise demo.
# demo: force the localStorage adapter even if Supabase values are present.
# supabase is not a separate variable; presence of the two VITE_SUPABASE_* values selects it.
# VITE_DATA_MODE=demo
# Legacy alias of VITE_DATA_MODE.
# VITE_DAN_DATA_MODE=demo

# --- Build public value (optional) ---
# GitHub Pages project site uses /dan/. Cloudflare and local dev use /.
# Set in the GitHub Pages workflow. Not a secret.
# VITE_BASE=/

# --- Not read by the SPA ---
# Auth Site URL and redirect allow-list are Supabase dashboard settings.
# There is no payment-provider variable. Production cannot mark a deal PAID from the browser.
# Storage bucket dan-v1-evidence is private and has no public URL variable.
# Realtime uses the same public Supabase client. No extra key.
# service_role / database URL / Cloudflare tokens must never be VITE_*.

# --- Local machine-only, never VITE_ and never commit ---
# Postgres URL for `npm run db:seed:staging` only.
# Also set DAN_SEED_TARGET=staging.
# Remote seed additionally needs DAN_STAGING_CONFIRM=seed-staging-only
# and DAN_STAGING_SUPABASE_PROJECT_REF matching the DB host project ref.
# The command refuses DAN_ENV=production, NODE_ENV=production, demo mode,
# a missing expected ref, a mismatched ref, and the known production project ref.
# SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DAN_SEED_TARGET=staging
# DAN_STAGING_CONFIRM=seed-staging-only
# DAN_STAGING_SUPABASE_PROJECT_REF=
# DAN_ENV=staging

# Remote SQL apply scripts are default-deny. They never default to production.
# DAN_ENV=staging
# DAN_REMOTE_CONFIRM=apply-staging-only
# DAN_STAGING_SUPABASE_PROJECT_REF=
# or, only if production apply is intentional:
# DAN_ENV=production
# DAN_REMOTE_CONFIRM=apply-production-only
# DAN_SUPABASE_PROJECT_REF=

# Playwright override for an already running app. Not used by production.
# DAN_E2E_BASE_URL=http://127.0.0.1:5173

# --- GitHub Actions / Environment "staging" secret NAMES only ---
# Put values in GitHub, never in this file. Never copy production secret values.
# STAGING_VITE_SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
# STAGING_VITE_SUPABASE_ANON_KEY=YOUR-STAGING-ANON-OR-PUBLISHABLE-KEY
# STAGING_CLOUDFLARE_API_TOKEN=YOUR-STAGING-SCOPED-TOKEN
# STAGING_CLOUDFLARE_ACCOUNT_ID=YOUR-CLOUDFLARE-ACCOUNT-ID
# STAGING_SUPABASE_DB_URL=postgresql://postgres:YOUR-STAGING-DB-PASSWORD@db.YOUR-STAGING-PROJECT.supabase.co:5432/postgres
#
# Cloudflare Pages project name is not a secret. Staging is hardcoded as dan-v1-staging-jongwoon.
# Never use occupied dan-staging.
# Production names that must not be reused: dan, dan.pages.dev, VITE_SUPABASE_URL,
# VITE_SUPABASE_ANON_KEY, CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID.
